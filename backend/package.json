{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "platform:generate": "prisma generate --config ./prisma.platform.config.ts",
    "platform:migrate": "prisma migrate dev --config ./prisma.platform.config.ts",
    "platform:deploy": "prisma migrate deploy --config ./prisma.platform.config.ts",
    "tenant:generate": "prisma generate --config ./prisma.tenant.config.ts",
    "tenant:template": "prisma migrate diff --from-empty --to-schema prisma/tenant/schema.prisma --script --config ./prisma.tenant.config.ts",
    "tenant:provision": "tsx src/scripts/provision-tenant.ts",
    "tenant:migrate-all": "tsx src/scripts/migrate-tenants.ts",
    "tenant:drop": "tsx src/scripts/drop-tenant.ts",
    "seed:users": "tsx src/scripts/seed-users.ts",
    "seed:credentials": "tsx src/scripts/seed-integration-credentials.ts",
    "mpesa:expire": "tsx src/scripts/expire-mpesa.ts",
    "inventory:rebuild-stock-value": "tsx src/scripts/rebuild-stock-value.ts",
    "leases:expire": "tsx src/scripts/expire-leases.ts",
    "etims:retry": "tsx src/scripts/etims-retry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:typecheck": "tsc -p test/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "3.2.7",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "3.2.7"
  }
}
