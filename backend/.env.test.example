# ===========================================================================
# TEST ENVIRONMENT (Task T-A1) — copy to `.env.test` (git-ignored) and adjust
# DATABASE_URL to your local Postgres credentials.
#
# Same key set as .env.example. EVERY value here is TEST-ONLY and PUBLIC: none of
# them is, or may ever become, a real secret. The CI workflow
# (.github/workflows/backend-ci.yml) uses these same values.
#
# THE TEST DATABASE IS A SEPARATE DATABASE, `angaza_test`, NEVER `angaza_core`.
# The suite's global setup refuses to run unless the database name in
# DATABASE_URL matches /test/i — a misconfigured run cannot provision or drop
# anything in a real database.
#
# vitest.config.ts loads this file's sibling `.env.test` BEFORE the application's
# own `import "dotenv/config"` runs. dotenv never overrides a variable that is
# already set, so the app's `.env` cannot redirect the suite at angaza_core.
# ===========================================================================

# --- PRODUCTION CONFIG keys (test values) ----------------------------------

# A separate database on the same Postgres. Create it once:
#   createdb angaza_test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/angaza_test?schema=public"

NODE_ENV=test
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
API_DOCS_ENABLED=false

# >= 32 characters. Test-only.
JWT_SECRET=t-a1-test-only-jwt-secret-not-a-real-secret-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000
# SENSITIVE rate-limit tier (Task T-A2): secret writes and report generation, per IP per route.
SENSITIVE_RATE_LIMIT_MAX=30
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000

# --- Notifications (Task T-A3) -------------------------------------------------
# Which implementation each channel uses (a DEPLOYMENT property). Default: simulated
# (no network). Live providers read their credentials from the encrypted platform
# store (platform_integration_credentials), NEVER from env.
NOTIFICATION_SMS_PROVIDER=simulated
NOTIFICATION_EMAIL_PROVIDER=simulated

# --- Password recovery (Task T-A4) ---------------------------------------------
# How long a password reset code stays usable, in minutes.
PASSWORD_RESET_TTL_MINUTES=60

# --- Staff invitations (Task T-A5) ---------------------------------------------
# How long an invitation stays usable, in hours.
INVITATION_TTL_HOURS=72

# --- DEV-ONLY ---------------------------------------------------------------
# Throwaway password for the users the test suite creates. Must satisfy the
# password policy (src/auth/password.ts).
SEED_PASSWORD=Test-Only-Throwaway-2026

# --- PRODUCTION CONFIG keys (continued, test values) ------------------------

# Base64 of the 32 ASCII bytes "angaza-t-a1-test-key-not-secret!". Public, test-only.
CREDENTIAL_ENCRYPTION_KEY=YW5nYXphLXQtYTEtdGVzdC1rZXktbm90LXNlY3JldCE=

MPESA_PROVIDER=simulated
# >= 16 characters. Test-only.
MPESA_CALLBACK_PATH_SECRET=t-a1-test-only-callback-path-secret
MPESA_SIM_DELAY_MS=1500
# MPESA_CALLBACK_BASE_URL is required only under MPESA_PROVIDER=daraja (never in tests).
# MPESA_SHORTCODE=174379

ETIMS_PROVIDER=simulated
ETIMS_SIM_OUTCOME=sign
